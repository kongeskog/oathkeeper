const proposal_note = EncodingRecord { id: "constitution.authority.proposal", citations: [SourceAnchor { source_id: "us.archives.constitution", locator: "Article V, congressional proposal route" }], rationale: "Check two-thirds arithmetic separately in both supplied denominators", assumptions: ["Legally appropriate denominators are supplied rather than inferred from total membership", "No quorum, valid voting, proposal-text identity, convention route or substantive limitation determination"], review: ReviewStatus.Unreviewed };
const ratification_note = EncodingRecord { id: "constitution.authority.ratification", citations: [SourceAnchor { source_id: "us.archives.constitution", locator: "Article V" }], rationale: "Post-1808 conditional check of selected ratification mode, three-fourths tally and supplied proposal, timing, validity and equal-suffrage findings", assumptions: ["State inventory at the assessment date is complete and denominators are legally appropriate", "Counted ratifications concern identical proposed text and the specified mode; validity is a supplied finding", "Deadline authority, timeliness, rescission, recognition and consent authenticity are not adjudicated", "No automatic inference of effective date, certification or constitutional legitimacy"], review: ReviewStatus.Unreviewed };
