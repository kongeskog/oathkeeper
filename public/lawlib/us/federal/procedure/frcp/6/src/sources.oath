const deadline_note = EncodingRecord {
    id: "frcp.6a.forward_days.v1",
    citations: [SourceAnchor { source_id: "us.uscourts.frcp.2025", locator: "Rule 6(a)(1), (3)(A), (5), (6); printed pages 12-13; PDF pages 31-32 (one-based)" }],
    rationale: "Exclude the trigger day; count all intermediate days; advance the final day over weekends and supplied legal holidays. For filing, also advance over supplied inaccessible days. This is a date computation conditional on the selected text and accepted premises.",
