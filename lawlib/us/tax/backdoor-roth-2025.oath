oathkeeper "0.5";
module lawlib.us.tax.backdoor-roth-2025 @ "0.2.0";
// Requires kernel 0.5.0: checked integer quantity arithmetic.
type Taxpayer;
jurisdiction us { name "United States"; parents []; }
predicate tax.scope2025(Taxpayer);
predicate tax.age(Taxpayer, integer);
predicate tax.within_contribution_limits(Taxpayer);
predicate tax.annual_limit(Taxpayer, quantity(usd_cent));
predicate tax.contribution(Taxpayer, quantity(usd_cent));
predicate tax.other_contributions(Taxpayer, quantity(usd_cent));
predicate tax.compensation(Taxpayer, quantity(usd_cent));
predicate tax.prior_basis(Taxpayer, quantity(usd_cent));
predicate tax.following_year_contribution(Taxpayer, quantity(usd_cent));
predicate tax.dec31_balance(Taxpayer, quantity(usd_cent));
predicate tax.converted(Taxpayer, quantity(usd_cent));
predicate tax.total_basis(Taxpayer, quantity(usd_cent));
predicate tax.available_basis(Taxpayer, quantity(usd_cent));
predicate tax.aggregate_pool(Taxpayer, quantity(usd_cent));
predicate tax.nontaxable_estimate(Taxpayer, quantity(usd_cent));
predicate tax.taxable_estimate(Taxpayer, quantity(usd_cent));
predicate tax.remaining_basis_estimate(Taxpayer, quantity(usd_cent));
predicate tax.allocation_estimate(Taxpayer, quantity(usd_cent), quantity(usd_cent), quantity(usd_cent));

source form8606 {
  citation "IRS Form 8606 (2025)";
  uri "https://www.irs.gov/pub/irs-prior/f8606--2025.pdf";
  sha256 "748a2bf2ef45918eac8d48fab8b1958c8c0c24102b7d2103c78f6f92a69486ae";
}
authority us.tax.form8606 {
  kind administrative_guidance; jurisdiction "us"; issuing_body "us.irs";
  publication published; decided_at null; source form8606;
}

source instructions8606 {
  citation "IRS Instructions for Form 8606 (2025)";
  uri "https://www.irs.gov/pub/irs-prior/i8606--2025.pdf";
  sha256 "735fb7aebc36f6c933d0623a5ba680e7133b9fe62549ddd9652319fc8cac7e8f";
}
authority us.tax.instructions8606 {
  kind administrative_guidance; jurisdiction "us"; issuing_body "us.irs";
  publication published; decided_at null; source instructions8606;
}

source publication590a {
  citation "IRS Publication 590-A (2025)";
  uri "https://www.irs.gov/pub/irs-prior/p590a--2025.pdf";
  sha256 "ca0e42873cfd66d2d9bfd082125d381f8a0c2f3b0a441d7d65ab5ccc06a0e1c7";
}
authority us.tax.publication590a {
  kind administrative_guidance; jurisdiction "us"; issuing_body "us.irs";
  publication published; decided_at null; source publication590a;
}

source notice202480 {
  citation "IRS Notice 2024-80, 2025 retirement contribution limits";
  uri "https://www.irs.gov/pub/irs-drop/n-24-80.pdf";
  sha256 "cbf7843c9c25317455e0373ad70381a13b80ab3dd2ff777f05d1d84ed22e59ad";
}
authority us.tax.notice202480 {
  kind administrative_guidance; jurisdiction "us"; issuing_body "us.irs";
  publication published; decided_at null; source notice202480;
}

rule us.tax.2025.limit-under50(person: Taxpayer, age: integer) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source publication590a;
  authority { authority "us.tax.publication590a"; role text; pinpoint "Chapter 1, How Much Can Be Contributed?"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.age($person, $age);
  requires not oathkeeper.integer.lt($age, 0);
  requires oathkeeper.integer.lt($age, 50);
  ensures tax.annual_limit($person, 700000[usd_cent]);
}
assessment us.tax.2025.limit-under50.assessment {
  authority "us.tax.publication590a"; rule "us.tax.2025.limit-under50"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source publication590a; rationale "2025 only. Regular traditional and Roth contributions share the annual limit. Compensation is checked separately; no spousal compensation rule is modeled. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.limit-50plus(person: Taxpayer, age: integer) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source publication590a;
  authority { authority "us.tax.publication590a"; role text; pinpoint "Chapter 1, How Much Can Be Contributed?"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.age($person, $age);
  requires not oathkeeper.integer.lt($age, 50);
  ensures tax.annual_limit($person, 800000[usd_cent]);
}
assessment us.tax.2025.limit-50plus.assessment {
  authority "us.tax.publication590a"; rule "us.tax.2025.limit-50plus"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source publication590a; rationale "Age at the end of 2025; the catch-up limit is 8000 dollars, not the different 2026 limit. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.contribution-limit(person: Taxpayer, contribution: quantity(usd_cent), other: quantity(usd_cent), total: quantity(usd_cent), limit: quantity(usd_cent), compensation: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source publication590a;
  authority { authority "us.tax.publication590a"; role text; pinpoint "Chapter 1, How Much Can Be Contributed? and Nondeductible Contributions"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.contribution($person, $contribution);
  requires tax.other_contributions($person, $other);
  requires tax.compensation($person, $compensation);
  requires not oathkeeper.quantity.lt($contribution, 0[usd_cent]);
  requires not oathkeeper.quantity.lt($other, 0[usd_cent]);
  requires not oathkeeper.quantity.lt($compensation, 0[usd_cent]);
  requires tax.annual_limit($person, $limit);
  requires oathkeeper.quantity.add($contribution, $other, $total);
  requires not oathkeeper.quantity.gt($total, $limit);
  requires not oathkeeper.quantity.gt($total, $compensation);
  ensures tax.within_contribution_limits($person);
}
assessment us.tax.2025.contribution-limit.assessment {
  authority "us.tax.publication590a"; rule "us.tax.2025.contribution-limit"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source publication590a; rationale "A conditional amount-limit check. Scope supplies timely eligible contributions and designation as nondeductible. No deduction, direct-Roth MAGI test, spousal IRA rule, or overall tax optimization is inferred. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.total-basis(person: Taxpayer, contribution: quantity(usd_cent), prior: quantity(usd_cent), total: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part I, lines 1-3"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.contribution($person, $contribution);
  requires tax.prior_basis($person, $prior);
  requires not oathkeeper.quantity.lt($prior, 0[usd_cent]);
  requires oathkeeper.quantity.add($contribution, $prior, $total);
  ensures tax.total_basis($person, $total);
}
assessment us.tax.2025.total-basis.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.total-basis"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "Prior basis is supplied from records, never inferred to be zero from missing Form 8606. Scope excludes basis adjustments and other current-year deductible traditional contributions. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.available-basis(person: Taxpayer, contribution: quantity(usd_cent), total: quantity(usd_cent), late: quantity(usd_cent), available: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part I, lines 4-5"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.total_basis($person, $total);
  requires tax.following_year_contribution($person, $late);
  requires tax.contribution($person, $contribution);
  requires not oathkeeper.quantity.lt($late, 0[usd_cent]);
  requires not oathkeeper.quantity.gt($late, $contribution);
  requires oathkeeper.quantity.subtract($total, $late, $available);
  ensures tax.available_basis($person, $available);
}
assessment us.tax.2025.available-basis.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.available-basis"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "2025-designated contributions made January 1 through April 15, 2026 are removed from basis available for 2025 conversions. No disaster-deadline relief is modeled. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.aggregate-pool(person: Taxpayer, balance: quantity(usd_cent), converted: quantity(usd_cent), pool: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part I, lines 6-9; traditional IRA definition above Part I"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.dec31_balance($person, $balance);
  requires not oathkeeper.quantity.lt($balance, 0[usd_cent]);
  requires tax.converted($person, $converted);
  requires oathkeeper.quantity.gt($converted, 0[usd_cent]);
  requires oathkeeper.quantity.add($balance, $converted, $pool);
  ensures tax.aggregate_pool($person, $pool);
}
assessment us.tax.2025.aggregate-pool.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.aggregate-pool"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "Scope requires the owner's combined traditional, traditional SEP and traditional SIMPLE IRA balances at all custodians. No spouse's IRA or employer 401(k) balance. Line 7 and special line 6 adjustments are zero by explicit scope assumption. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.nontaxable-allocation(person: Taxpayer, converted: quantity(usd_cent), basis: quantity(usd_cent), pool: quantity(usd_cent), nontaxable: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part I, lines 10-11; Part II, line 17"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.within_contribution_limits($person);
  requires tax.converted($person, $converted);
  requires tax.available_basis($person, $basis);
  requires tax.aggregate_pool($person, $pool);
  requires oathkeeper.quantity.allocate($converted, $basis, $pool, $nontaxable);
  ensures tax.nontaxable_estimate($person, $nontaxable);
}
assessment us.tax.2025.nontaxable-allocation.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.nontaxable-allocation"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "Exact rational allocation capped at one, then rounded once to nearest cent with ties up. This is an allocation estimate, not a completed Form 8606: the form permits a decimal ratio rounded to at least three places and filing rounding can differ. The arithmetic convention is explicit and requires independent formalization review. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.taxable-allocation(person: Taxpayer, converted: quantity(usd_cent), nontaxable: quantity(usd_cent), taxable: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part II, lines 16-18"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.converted($person, $converted);
  requires tax.nontaxable_estimate($person, $nontaxable);
  requires oathkeeper.quantity.subtract($converted, $nontaxable, $taxable);
  ensures tax.taxable_estimate($person, $taxable);
}
assessment us.tax.2025.taxable-allocation.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.taxable-allocation"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "Amount included in income estimate, not tax owed. Rates, penalties, credits, Medicare effects, state taxes and future Roth withdrawals are outside scope. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.carryforward-basis(person: Taxpayer, total: quantity(usd_cent), nontaxable: quantity(usd_cent), remaining: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part I, lines 13-14"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.total_basis($person, $total);
  requires tax.nontaxable_estimate($person, $nontaxable);
  requires oathkeeper.quantity.subtract($total, $nontaxable, $remaining);
  ensures tax.remaining_basis_estimate($person, $remaining);
}
assessment us.tax.2025.carryforward-basis.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.carryforward-basis"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "Includes 2025-designated contributions made in early 2026. No other distributions or adjustments; shares the allocation rounding convention. Independent tax-professional and formalization review pending.";
}

rule us.tax.2025.allocation-summary(person: Taxpayer, nontaxable: quantity(usd_cent), taxable: quantity(usd_cent), remaining: quantity(usd_cent)) @ "1" {
  time_basis law_time; jurisdiction "us";
  effective_from "2025-01-01T00:00:00Z"; effective_until "2026-01-01T00:00:00Z";
  recorded_at "2026-10-18T23:21:21Z"; source form8606;
  authority { authority "us.tax.form8606"; role text; pinpoint "Part I, lines 11 and 14; Part II, line 18"; scope tax.scope2025($person); };
  requires tax.scope2025($person);
  requires tax.within_contribution_limits($person);
  requires tax.nontaxable_estimate($person, $nontaxable);
  requires tax.taxable_estimate($person, $taxable);
  requires tax.remaining_basis_estimate($person, $remaining);
  ensures tax.allocation_estimate($person, $nontaxable, $taxable, $remaining);
}
assessment us.tax.2025.allocation-summary.assessment {
  authority "us.tax.form8606"; rule "us.tax.2025.allocation-summary"; rule_version "1";
  forum "us.federal.tax"; as_of "2025-12-31T00:00:00Z"; recorded_at "2026-10-18T23:21:21Z";
  force persuasive; treatment operative; review_status machine_assisted_unreviewed;
  source form8606; rationale "Summarizes one bounded conditional calculation. IRS guidance is classified as administrative guidance, with persuasive model assessments rather than binding legislation. Neither input authenticity nor legal fidelity is established by proof replay. Independent tax-professional and formalization review pending.";
}

