coverage coverage.tax.2025 {
  question "What follows for tax.allocation_estimate under this bounded, community-reviewable formalization?";
  conclusion_kind "calculation";
  parameters [
    {
      name "person";
      sort {
        domain "Taxpayer";
      };
    },
    {
      name "nontaxable";
      sort {
        quantity {
          unit "usd_cent";
        };
      };
    },
    {
      name "taxable";
      sort {
        quantity {
          unit "usd_cent";
        };
      };
    },
    {
      name "remaining";
      sort {
        quantity {
          unit "usd_cent";
        };
      };
    }
  ];
  goal tax.allocation_estimate($person, $nontaxable, $taxable, $remaining);
  jurisdictions ["us"];
  forums ["us.federal.tax"];
  law_from "2025-01-01T00:00:00Z";
  law_until "2026-01-01T00:00:00Z";
