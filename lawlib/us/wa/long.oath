oathkeeper "0.5";
module lawlib.us.wa.long @ "0.5.0";
import "../timbs.oath" sha256 "909c5ae31f0029536f0e444fd781068f98453871ba2db2da10cd0a1238db90fd";

jurisdiction us.wa {
  name "Washington";
  parents ["us"];
}

source long2021 {
  citation "City of Seattle v. Long, 198 Wn.2d 136, 493 P.3d 94 (2021), No. 98824-2, majority slip opinion";
  uri "https://www.courts.wa.gov/opinions/pdf/988242.pdf";
  sha256 "421932863eff58799db3a23427d8641503c62841da191059f2f744f0248f27fa";
}

authority us.wa.sc.long.2021 {
  kind "case";
  jurisdiction "us.wa";
  issuing_body "us.wa.supreme-court";
  publication "published";
  source long2021;
  decided_at "2021-08-12T15:00:00Z";
}

rule wa.long.partially-punitive(matter: Matter) @ "1" {
  time_basis authority_time;
  jurisdiction "us.wa";
  effective_from "2021-08-12T15:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source long2021;
  authority {
    authority "us.wa.sc.long.2021";
    role "holding";
    pinpoint "Majority slip pp. 26-30, part III.C.i";
    scope scope.long.smc72-sanction($matter);
  };
  requires scope.long.smc72-sanction($matter);
  requires parking.subject_to_ch11_30_impoundment($matter);
  requires sanction.impoundment_and_associated_costs($matter);
  ensures sanction.partially_punitive($matter);
}

rule wa.long.qualifying-fine(matter: Matter) @ "1" {
  time_basis authority_time;
  jurisdiction "us.wa";
  effective_from "2021-08-12T15:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source long2021;
  authority {
    authority "us.wa.sc.long.2021";
    role "holding";
    pinpoint "Majority slip pp. 21, 25-30, part III.C";
    scope scope.long.federal-excessive-fines($matter);
  };
  requires scope.long.federal-excessive-fines($matter);
  requires constitutional.excessive_fines_clause_applies($matter);
  requires sanction.partially_punitive($matter);
  requires sanction.government_extraction_for_offense($matter);
  ensures sanction.qualifying_fine($matter);
}

rule wa.long.gross-disproportionality(matter: Matter) @ "1" {
  time_basis authority_time;
  jurisdiction "us.wa";
  effective_from "2021-08-12T15:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source long2021;
  authority {
    authority "us.wa.sc.long.2021";
    role "holding";
    pinpoint "Majority slip pp. 30, 37-40, parts III.C.ii and III.D";
    scope scope.long.federal-excessive-fines($matter);
  };
  requires scope.long.federal-excessive-fines($matter);
  requires sanction.qualifying_fine($matter);
  requires sanction.grossly_disproportionate($matter);
  ensures constitutional.excessive_fines_violation($matter);
}

rule wa.long.ability-to-pay(matter: Matter) @ "1" {
  time_basis authority_time;
  jurisdiction "us.wa";
  effective_from "2021-08-12T15:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source long2021;
  authority {
    authority "us.wa.sc.long.2021";
    role "holding";
    pinpoint "Majority slip pp. 37-38, parts III.C.ii and III.D";
    scope scope.long.federal-excessive-fines($matter);
  };
  requires scope.long.federal-excessive-fines($matter);
  requires sanction.qualifying_fine($matter);
  ensures analysis.consider_ability_to_pay($matter);
}

rule wa.long.homestead-no-declaration(matter: Matter) @ "1" {
  time_basis authority_time;
  jurisdiction "us.wa";
  effective_from "2021-08-12T15:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source long2021;
  authority {
    authority "us.wa.sc.long.2021";
    role "holding";
    pinpoint "Majority slip pp. 7-12, part I.A";
    scope scope.long.rcw6_13_040-occupied-property($matter);
  };
  requires scope.long.rcw6_13_040-occupied-property($matter);
  requires homestead.owner_occupies_personal_property_as_principal_residence($matter);
  ensures not homestead.additional_declaration_required($matter);
}

rule wa.long.no-automatic-impoundment-bar(matter: Matter) @ "1" {
  time_basis authority_time;
  jurisdiction "us.wa";
  effective_from "2021-08-12T15:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source long2021;
  authority {
    authority "us.wa.sc.long.2021";
    role "holding";
    pinpoint "Majority slip p. 20, end of part II";
    scope scope.long.independent-parking-impoundment($matter);
  };
  requires scope.long.independent-parking-impoundment($matter);
  ensures not homestead.automatically_prevents_parking_impoundment($matter);
}

assessment wa.long.partially-punitive.assessment.2021-08-13 {
  authority "us.wa.sc.long.2021";
  rule "wa.long.partially-punitive";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force "binding";
  treatment "operative";
  review_status "machine_assisted_unreviewed";
  source long2021;
  rationale "Long characterizes the particular statutory impoundment and associated costs as partially punitive; the rule is limited by the declared Long/SMC72 sanction scope. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
}

assessment wa.long.qualifying-fine.assessment.2021-08-13 {
  authority "us.wa.sc.long.2021";
  rule "wa.long.qualifying-fine";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force "binding";
  treatment "operative";
  review_status "machine_assisted_unreviewed";
  source long2021;
  rationale "A governmental extraction as punishment at least in part qualifies for excessive-fines scrutiny; qualifying as a fine does not establish excessiveness. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
}

assessment wa.long.gross-disproportionality.assessment.2021-08-13 {
  authority "us.wa.sc.long.2021";
  rule "wa.long.gross-disproportionality";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force "binding";
  treatment "operative";
  review_status "machine_assisted_unreviewed";
  source long2021;
  rationale "The violation rule requires a separately established gross-disproportionality judgment. That judgment cannot be obtained from poverty or a numerical fine threshold alone. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
}

assessment wa.long.ability-to-pay.assessment.2021-08-13 {
  authority "us.wa.sc.long.2021";
  rule "wa.long.ability-to-pay";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force "binding";
  treatment "operative";
  review_status "machine_assisted_unreviewed";
  source long2021;
  rationale "Long requires consideration of ability to pay as part of its disproportionality analysis. This is a Washington Supreme Court holding; it is not attributed to Timbs as a nationwide Supreme Court holding. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
}

assessment wa.long.homestead-no-declaration.assessment.2021-08-13 {
  authority "us.wa.sc.long.2021";
  rule "wa.long.homestead-no-declaration";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force "binding";
  treatment "operative";
  review_status "machine_assisted_unreviewed";
  source long2021;
  rationale "Long interprets RCW 6.13.040(1) to recognize automatic protection for occupied personal property used as the owner principal residence. This rule does not decide exemption amounts or all statutory exceptions. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
}

assessment wa.long.no-automatic-impoundment-bar.assessment.2021-08-13 {
  authority "us.wa.sc.long.2021";
  rule "wa.long.no-automatic-impoundment-bar";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force "binding";
  treatment "operative";
  review_status "machine_assisted_unreviewed";
  source long2021;
  rationale "The majority distinguishes homestead protections at debt enforcement from independent parking impoundment authority. This does not endorse the broader concurring view as a majority holding and does not authorize unconstitutional impoundments. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
}

