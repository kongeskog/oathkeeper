rule seattle.parking.duration-threshold(matter: Matter, duration: quantity(ms)) @ "1" {
  time_basis law_time;
  jurisdiction "us.wa.seattle";
  effective_from "2001-11-28T08:00:00Z";
  effective_until null;
  recorded_at "2026-10-18T22:35:39Z";
  source ordinance120573;
  authority { authority "us.wa.seattle.ord120573"; role text; pinpoint "Section 1, SMC 11.72.440(B); scan PDF p. 3, lines 32-35"; scope scope.smc72.historical-text($matter); };
  requires scope.smc72.historical-text($matter);
  requires parking.duration($matter, $duration);
  requires oathkeeper.quantity.gt($duration, 259200000[ms]);
  ensures parking.over_72_hours($matter);
}

assessment seattle.parking.duration-threshold.assessment.2021-08-13 {
  authority "us.wa.seattle.ord120573";
  rule "seattle.parking.duration-threshold";
  rule_version "1";
  forum "us.wa.courts.state";
  as_of "2021-08-13T00:00:00Z";
  recorded_at "2026-10-18T22:35:39Z";
  force binding;
  treatment operative;
  review_status machine_assisted_unreviewed;
  source ordinance120573;
  rationale "Seventy-two elapsed hours equals 259200000 milliseconds. Exact integer units, strict greater-than, no rounding or implicit unit conversion. This arithmetic implementation does not independently establish elapsed parking time. Independent legal and formalization review pending.";
}

