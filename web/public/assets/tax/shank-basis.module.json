      "source": {
        "citation": "Shank v. Commissioner, T.C. Memo. 2018-33 (Mar. 20, 2018), No. 1752-17",
        "uri": "https://dawson.ustaxcourt.gov/case-detail/1752-17",
        "sha256": "94612d7eb8696cb883d356b49caf2129b517b088f68b4dd4d705e75724afec0e"
      },
      "rationale": "Missing historical returns did not prevent this taxpayer from establishing some basis. No inference that he never filed Form 8606, no automatic acceptance of unsupported basis, and no prospective rule that any testimony suffices. Independent legal and formalization review pending; no current citator claim."
    }
