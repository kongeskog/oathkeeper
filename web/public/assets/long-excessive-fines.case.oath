query {
  coverage "coverage.seattle.2";
  event_at "2016-10-12";
  authority_at "2021-08-13T00:00:00Z";
  purpose historical_reconstruction;
  temporal_rationale "Reconstruct the August 2021 opinion about the October 2016 impoundment. The event is recorded with date-only precision; the selected statutory snapshot is a supplied historical applicability assessment, not an automatic retroactivity rule.";
  jurisdiction "us.wa.seattle";
  as_of "2016-10-12T00:00:00-07:00";
  known_at "2026-10-18T22:35:39Z";
  forum "us.wa.courts.state";
