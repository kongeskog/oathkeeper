  root "violation";
}

proof {
  step historical-smc-scope: scope.smc72.historical-text(long.98824-2) by fact historical-smc-scope;
  step parking-violation: parking.violates_smc72(long.98824-2) by fact parking-violation;
  step statutory-framework: parking.subject_to_ch11_30_impoundment(long.98824-2) by apply seattle.parking.impoundment-framework @ "1"(matter = long.98824-2) using [historical-smc-scope, parking-violation];
  step incorporation-scope: scope.federal.excessive-fines-incorporation(long.98824-2) by fact incorporation-scope;
  step municipal-action: government.state_or_local_action(long.98824-2) by fact municipal-action;
  step incorporated: constitutional.excessive_fines_clause_applies(long.98824-2) by apply us.timbs.incorporation @ "1"(matter = long.98824-2) using [incorporation-scope, municipal-action];
  step sanction-scope: scope.long.smc72-sanction(long.98824-2) by fact sanction-scope;
  step impound-and-costs: sanction.impoundment_and_associated_costs(long.98824-2) by fact impound-and-costs;
  step punitive: sanction.partially_punitive(long.98824-2) by apply wa.long.partially-punitive @ "1"(matter = long.98824-2) using [sanction-scope, statutory-framework, impound-and-costs];
  step federal-scope: scope.long.federal-excessive-fines(long.98824-2) by fact federal-scope;
  step government-extraction: sanction.government_extraction_for_offense(long.98824-2) by fact government-extraction;
  step fine: sanction.qualifying_fine(long.98824-2) by apply wa.long.qualifying-fine @ "1"(matter = long.98824-2) using [federal-scope, incorporated, punitive, government-extraction];
  step disproportionality-finding: sanction.grossly_disproportionate(long.98824-2) by fact disproportionality-finding;
  step violation: constitutional.excessive_fines_violation(long.98824-2) by apply wa.long.gross-disproportionality @ "1"(matter = long.98824-2) using [federal-scope, fine, disproportionality-finding];
