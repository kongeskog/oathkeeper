  review_status "machine_assisted_unreviewed";
  source timbs2019;
  rationale "Timbs holds incorporation of the Excessive Fines Clause, not that every fine or every forfeiture is excessive. This is a machine-assisted historical assessment at the Long decision snapshot, not an independently reviewed citator result or a statement of current validity.";
