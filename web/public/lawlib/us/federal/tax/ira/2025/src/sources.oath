const contribution_note = EncodingRecord { id: "ira2025.contribution", citations: [SourceAnchor { source_id: "us.usc2024.26.219", locator: "219(b), (c), (f); annual amounts cross-checked with Notice 2024-80" }], rationale: "Apply the ordinary own-compensation annual aggregate cap; 2025 base 7000 and age-50 catch-up 1000", assumptions: ["Same-calendar-year cash contributions only","No spousal compensation allocation or special relief","Other personal IRA contributions are supplied as a complete aggregate"], review: ReviewStatus.Unreviewed };
const nondeductible_note = EncodingRecord { id: "ira2025.basis", citations: [SourceAnchor { source_id: "us.usc2024.26.408", locator: "408(o); Form 8606 Part I" }], rationale: "A supplied nondeductible designation, no claimed deduction, and contribution requirements establish the modeled current basis addition", assumptions: ["Deductibility and MAGI phaseouts are outside this package","Designation is a supplied premise, not an electronic filing"], review: ReviewStatus.Unreviewed };
const conversion_note = EncodingRecord { id: "ira2025.conversion", citations: [SourceAnchor { source_id: "us.usc2024.26.408a", locator: "408A(d)(3), (c)(5)(B)" }], rationale: "Separate conversion treatment from regular contribution limits; exact income allocation is another query", assumptions: ["Own accounts, ordinary trustee-to-trustee transactions and qualifying Roth destination","RMDs, inherited accounts, corrections, rollovers and special transactions excluded"], review: ReviewStatus.Unreviewed };
