module std.numeric;
enum RoundingMode { Floor, Ceiling, TowardZero, HalfAwayFromZero, HalfEven }
fn min(a: Rational, b: Rational) -> Rational { if a < b { a } else { b } }
fn max(a: Rational, b: Rational) -> Rational { if a > b { a } else { b } }
fn abs(value: Rational) -> Rational { if value < 0.0 { -value } else { value } }
fn round(value: Rational, quantum: Rational, mode: RoundingMode) -> Rational {
    if quantum <= 0.0 { fail("rounding quantum must be positive") } else {
        let units = value / quantum;
        let lower = floor(units);
        let fraction = units - to_rational(lower);
        let rounded = match mode {
            RoundingMode.Floor => lower,
            RoundingMode.Ceiling => if fraction == 0.0 { lower } else { lower + 1 },
            RoundingMode.TowardZero => if units < 0.0 and fraction != 0.0 { lower + 1 } else { lower },
            RoundingMode.HalfAwayFromZero => if fraction < 0.5 { lower } else if fraction > 0.5 { lower + 1 } else if units < 0.0 { lower } else { lower + 1 },
            RoundingMode.HalfEven => if fraction < 0.5 { lower } else if fraction > 0.5 { lower + 1 } else if lower % 2 == 0 { lower } else { lower + 1 }
        };
        to_rational(rounded) * quantum
    }
}
